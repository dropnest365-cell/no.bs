# Copy this to .env and adjust values. Local defaults work out of the box.
# The server loads .env from the project root or from server/.env.

NODE_ENV=development
PORT=4000
DATABASE_URL="file:./dev.db"
JWT_SECRET=dev-only-secret-change-me-before-deploying-please
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Leave blank: rule-based fallbacks power the AI features with no key.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# Optional admin bootstrap for `npm run db:seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
