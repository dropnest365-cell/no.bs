# ---- Server ----
NODE_ENV=development
PORT=4000
# SQLite for local development. Path is relative to server/prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Generate long random values, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated list of allowed browser origins (dev defaults are fine)
CLIENT_ORIGIN=http://localhost:5173
# In production behind HTTPS, set to true so cookies are Secure
COOKIE_SECURE=false

# ---- Optional AI provider ----
# Leave blank to use the built-in rule-based mentor, analyzer and roadmap engine.
# Works with any OpenAI-compatible chat-completions endpoint. AI_API_KEY is
# read server-side only and is never sent to the browser.
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=

# ---- Optional first admin bootstrap ----
# If both are set, `npm run db:seed` creates/promotes this account as ADMIN.
# Leave blank to create no admin; use `npm run make-admin -- you@example.com`
# after registering a normal account instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
